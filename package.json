{
  "name": "webhook-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/local.ts",
    "test": "vitest run",
    "build": "tsc --noEmit && esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda.cjs && zip -q -j dist/webhook-bridge.zip dist/lambda.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1166.0",
    "@aws-sdk/client-ssm": "^3.1166.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "smee-client": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
